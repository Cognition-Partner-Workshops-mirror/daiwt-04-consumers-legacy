table 'Customer'

	column 'Customer Key'
		dataType: int64
		summarizeBy: none
		sourceColumn: Customer Key

	column 'Customer'
		dataType: string
		summarizeBy: none
		sourceColumn: Customer

	partition 'Customer' = m
		mode: import
		source =
			let
				Source = Sql.Database(Server, Database),
				Data = Source{[Schema="Dimension", Item="Customer"]}[Data],
				Selected = Table.SelectColumns(Data, {"Customer Key", "Customer"})
			in
				Selected
