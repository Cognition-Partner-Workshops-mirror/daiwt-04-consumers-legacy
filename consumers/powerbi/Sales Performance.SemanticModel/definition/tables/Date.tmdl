table 'Date'
	dataCategory: Time

	column 'Date'
		isKey
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Date

	column 'Calendar Year'
		dataType: int64
		summarizeBy: none
		sourceColumn: Calendar Year

	column 'Calendar Month Number'
		dataType: int64
		summarizeBy: none
		sourceColumn: Calendar Month Number

	column 'Beginning of Month'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Beginning of Month

	partition 'Date' = m
		mode: import
		source =
			let
				Source = Sql.Database(Server, Database),
				Data = Source{[Schema="Dimension", Item="Date"]}[Data],
				WithMonth = Table.AddColumn(Data, "Beginning of Month", each Date.StartOfMonth([Date]), type date),
				Selected = Table.SelectColumns(WithMonth, {"Date", "Calendar Year", "Calendar Month Number", "Beginning of Month"})
			in
				Selected
