table 'Order'

	measure 'Order Value' = SUM('Order'[Total Excluding Tax])
		formatString: #,0.00

	measure 'Order Count' = DISTINCTCOUNT('Order'[WWI Order ID])
		formatString: #,0.00

	measure 'Unpicked Lines' = CALCULATE(COUNTROWS('Order'), ISBLANK('Order'[Picked Date Key]))
		formatString: #,0.00

	column 'Order Key'
		dataType: int64
		summarizeBy: none
		sourceColumn: Order Key

	column 'Customer Key'
		dataType: int64
		summarizeBy: none
		sourceColumn: Customer Key

	column 'City Key'
		dataType: int64
		summarizeBy: none
		sourceColumn: City Key

	column 'Stock Item Key'
		dataType: int64
		summarizeBy: none
		sourceColumn: Stock Item Key

	column 'Order Date Key'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Order Date Key

	column 'Total Excluding Tax'
		dataType: decimal
		summarizeBy: none
		sourceColumn: Total Excluding Tax

	column 'WWI Order ID'
		dataType: int64
		summarizeBy: none
		sourceColumn: WWI Order ID

	column 'Picked Date Key'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Picked Date Key

	partition 'Order' = m
		mode: import
		source =
			Value.NativeQuery(Sql.Database(Server, Database), "SELECT [Order Key], [Customer Key], [City Key], [Stock Item Key], [Order Date Key], [Total Excluding Tax], [WWI Order ID], [Picked Date Key] FROM [Fact].[Order]", null, [EnableFolding=true])
