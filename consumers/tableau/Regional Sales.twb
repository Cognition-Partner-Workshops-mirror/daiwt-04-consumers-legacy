<worksheet name="Regional Targets"><table><view><datasources><datasource name="Reporting" caption="Regional Sales"/><datasource name="Parameters"/></datasources>
<datasource-dependencies datasource="Reporting"><column datatype="string" name="[territory]" role="dimension" type="nominal"/>
<column datatype="integer" name="[sales_year]" role="dimension" type="nominal"/>
<column datatype="real" name="[sales]" role="measure" type="quantitative"/><column caption="Value vs Target" datatype="real" name="[Value vs Target]" role="measure" type="quantitative"><calculation class="tableau" formula="ZN(SUM([sales])) / [Parameters].[Target Value]"/></column>
<column caption="Above Target" datatype="real" name="[Above Target]" role="measure" type="quantitative"><calculation class="tableau" formula="IIF(ZN(SUM([sales])) >= [Parameters].[Target Value], 1, 0)"/></column>
