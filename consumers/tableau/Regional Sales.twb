<column-instance column="[Above Target]" derivation="User" name="[usr:Above Target:qk]" pivot="key" type="quantitative"/><column-instance column="[Share of Total]" derivation="User" name="[usr:Share of Total:qk]" pivot="key" type="quantitative"/>
</datasource-dependencies><aggregation value="true"/></view><style/>
<panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto"/></view><mark class="Bar"/><encodings><color column="[Reporting].[usr:Above Target:qk]"/><size column="[Reporting].[usr:Share of Total:qk]"/></encodings></pane></panes>
