<?xml version="1.0" encoding="utf-8"?>
<workbook original-version="18.1" source-build="2023.1.0" source-platform="win" version="18.1" xmlns:user="http://www.tableausoftware.com/xml/user">
  <preferences/>
  <datasources>
    <datasource name="Parameters" hasconnection="false" inline="true" version="18.1">
      <column caption="Target Value" datatype="real" name="[Target Value]" param-domain-type="any" role="measure" type="quantitative" value="100000">
        <calculation class="tableau" formula="100000"/>
      </column>
    </datasource>
    <datasource caption="Regional Sales" inline="true" name="Reporting" version="18.1">
      <connection class="sqlserver" server="wwi-dw.corp.local" dbname="WideWorldImportersDW" authentication="prompt" port="1433">
        <relation name="ReportQuery" type="text">SELECT TOP (100) c.[Sales Territory] AS territory, DATEPART(year,s.[Invoice Date Key]) AS sales_year, ISNULL(SUM(s.[Total Excluding Tax]),0) AS sales FROM Fact.Sale s JOIN Dimension.City c ON s.[City Key]=c.[City Key] GROUP BY c.[Sales Territory], DATEPART(year,s.[Invoice Date Key])</relation>
      </connection>
      <column datatype="string" name="[territory]" role="dimension" type="nominal"/>
      <column datatype="real" name="[sales]" role="measure" type="quantitative"/>
      <column caption="Value vs Target" datatype="real" name="[Value vs Target]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([sales]) / [Parameters].[Target Value]"/>
      </column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Regional Sales">
      <table>
        <view>
          <datasources><datasource caption="Regional Sales" name="Reporting"/><datasource name="Parameters"/></datasources>
          <datasource-dependencies datasource="Reporting">
            <column datatype="string" name="[territory]" role="dimension" type="nominal"/>
            <column datatype="real" name="[sales]" role="measure" type="quantitative"/>
            <column-instance column="[territory]" derivation="None" name="[none:territory:nk]" pivot="key" type="nominal"/>
            <column-instance column="[sales]" derivation="Sum" name="[sum:sales:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <aggregation value="true"/>
        </view>
        <style/>
        <panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto"/></view><mark class="Bar"/></pane></panes>
        <rows>[Reporting].[none:territory:nk]</rows><cols>[Reporting].[sum:sales:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards><dashboard name="Regional Sales Overview"><style/><size maxheight="800" maxwidth="1200" minheight="800" minwidth="1200"/><zones><zone h="100000" id="1" name="Regional Sales" w="100000" x="0" y="0"/></zones></dashboard></dashboards>
  <windows><window class="worksheet" name="Regional Sales"/><window class="dashboard" name="Regional Sales Overview"/></windows>
</workbook>
